# Set this to the isolated Mission Control endpoint for your environment.
MISSION_CONTROL_BASE_URL=http://127.0.0.1:3015
MISSION_CONTROL_MODE=isolated
MISSION_CONTROL_PORT=3015
MISSION_CONTROL_DATA_DIR=./.runtime/mission-control-data
MISSION_CONTROL_AUTH_TOKEN=
DRY_RUN=true
REQUIRE_APPROVAL=true
ALLOW_PRODUCTION_WRITES=false
