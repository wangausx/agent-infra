{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-infra/collaboration-skill-manifest-v1",
  "schema": "agent-infra/collaboration-skill-manifest/v1",
  "skills": [
    {"id":"alert-correlation","purpose":"deduplicate and correlate incoming alerts into one incident","inputs":["alerts"],"outputs":["incident"],"invocation":"ALERT stage","dependent_tools":["read-alert-stream"],"failure_handling":"reject malformed input; escalate ambiguous correlation","security_boundary":"read-only; no remediation authority","reusable_for":["autonomy","payment"],"workflow_relationship":"precedes incident decomposition"},
    {"id":"rca-hypothesis-testing","purpose":"produce independent hypotheses with supporting and disconfirming evidence","inputs":["incident","observed_state"],"outputs":["hypotheses","adjudication_input"],"invocation":"parallel RCA stage","dependent_tools":["read-digital-twin","read-evidence-ledger"],"failure_handling":"preserve rejected hypotheses; escalate insufficient evidence","security_boundary":"read-only; cannot authorize action","reusable_for":["autonomy","payment"],"workflow_relationship":"feeds policy adjudication"},
    {"id":"policy-evaluation","purpose":"approve, reject, or pause a proposed bounded action","inputs":["recommendation","safety_flags","evidence"],"outputs":["policy_decision","authorization"],"invocation":"POLICY stage","dependent_tools":["policy-engine"],"failure_handling":"fail closed on missing safety or stale context","security_boundary":"authorization only; cannot execute remediation","reusable_for":["autonomy","payment"],"workflow_relationship":"gates action"},
    {"id":"bounded-remediation","purpose":"execute only an approved idempotent reversible action","inputs":["authorization","action","before_state"],"outputs":["after_state","action_evidence"],"invocation":"ACTION stage","dependent_tools":["simulation-remediation"],"failure_handling":"record failure and invoke compensation or escalation","security_boundary":"simulation_only=true; production_writes=false","reusable_for":["autonomy","payment"],"workflow_relationship":"follows policy"},
    {"id":"independent-verification","purpose":"verify observed state independently of executor claims","inputs":["observed_state","action_evidence"],"outputs":["verdict","compensation_requirement"],"invocation":"VERIFY stage","dependent_tools":["read-digital-twin","read-action-ledger"],"failure_handling":"reject, compensate, retry, or escalate","security_boundary":"cannot mutate remediation state","reusable_for":["autonomy","payment"],"workflow_relationship":"gates postmortem"},
    {"id":"postmortem-knowledge-consolidation","purpose":"consolidate only verifier-approved evidence into reusable knowledge","inputs":["verifier_report","trace","rejected_evidence"],"outputs":["postmortem","knowledge_rule"],"invocation":"POSTMORTEM stage","dependent_tools":["evidence-ledger","knowledge-store"],"failure_handling":"do not write knowledge when verification is rejected","security_boundary":"append-only evidence and approved knowledge only","reusable_for":["autonomy","payment"],"workflow_relationship":"feeds operations review"}
  ]
}
