    {"identity":"RCA-Calibration","layer":"operational","stage":"RCA","objective":"test sensor calibration hypothesis","inputs":["incident"],"outputs":["hypothesis-evidence"],"skills":["rca-hypothesis-evaluation"],"tools":["telemetry-reader"],"authority":{"may":["recommend"],"must_escalate":["policy-decision"]},"prohibited_actions":["authorize-action","mutate-shared-conclusion"],"failure_behavior":"record-inconclusive-evidence","escalation":"Policy-Safety","host_mapping":"Morgan"},
    {"identity":"RCA-Environment","layer":"operational","stage":"RCA","objective":"test environmental interference hypothesis","inputs":["incident"],"outputs":["hypothesis-evidence"],"skills":["rca-hypothesis-evaluation"],"tools":["telemetry-reader"],"authority":{"may":["recommend"],"must_escalate":["policy-decision"]},"prohibited_actions":["authorize-action","mutate-shared-conclusion"],"failure_behavior":"record-inconclusive-evidence","escalation":"Policy-Safety","host_mapping":"Morgan"},
