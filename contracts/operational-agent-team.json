    {"identity":"Remediation","layer":"operational","stage":"ACTION","objective":"request one bounded reversible remediation","inputs":["policy-decision"],"outputs":["action-result"],"skills":["bounded-remediation","compensation-and-rollback"],"tools":["simulation-action","rollback-registry"],"authority":{"may":["request-approved-action"],"must_escalate":["action-failure"]},"prohibited_actions":["execute-unapproved-action","production-write"],"failure_behavior":"compensate-and-escalate","escalation":"Policy-Safety","host_mapping":"Rex"},
