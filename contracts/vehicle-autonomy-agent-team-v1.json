{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "agent-infra/vehicle-autonomy-agent-team/v1",
  "metadata": {
    "name": "vehicle-autonomy-sensor-fusion-team",
    "version": "1.0.0",
    "scenario_id": "autonomy-sensor-fusion",
    "domain": "vehicle-autonomy",
    "safety_boundary": "deterministic digital twin only"
  },
  "agents": [
    {
      "identity": "Vehicle-Signal-Incident",
      "stage": "INCIDENT",
      "responsibility": "normalize, correlate, and deduplicate vehicle telemetry and deployment alerts",
      "inputs": ["alerts", "telemetry_snapshot", "deployment_event", "route_id"],
      "actions": ["validate_schema", "correlate_signals", "suppress_duplicates", "bind_source_lineage"],
      "outputs": ["vehicle_incident", "suppression_evidence"],
      "artifacts": ["incident.json", "suppression-evidence.jsonl"],
      "conditions": {"on_empty_or_malformed": "reject_before_side_effect", "on_ambiguous_correlation": "escalate_to_Vehicle-Safety-Policy"},
      "authority": {"may": ["read", "correlate", "suppress_duplicates"], "must_not": ["authorize_action", "execute_remediation"]},
      "skills": ["alert-correlation"],
      "tools": ["autonomy-fixture-reader", "telemetry-reader", "correlator"],
      "host_mapping": "Morgan"
    },
    {
      "identity": "Vehicle-Perception-RCA",
      "stage": "RCA",
      "responsibility": "test camera/LiDAR timestamp, fusion confidence, and sensor calibration hypotheses",
      "inputs": ["vehicle_incident", "sensor_timestamps", "fusion_metrics", "calibration_state"],
      "actions": ["read_observed_state", "score_hypothesis", "record_supporting_evidence", "record_disconfirming_evidence"],
      "outputs": ["perception_hypothesis"],
      "artifacts": ["rca-report.json"],
      "conditions": {"on_missing_sensor_data": "record_inconclusive_and_escalate", "on_disagreement": "preserve_hypothesis_for_policy_adjudication"},
      "authority": {"may": ["analyze", "recommend"], "must_not": ["authorize_action", "mutate_peer_hypothesis"]},
      "skills": ["rca-hypothesis-evaluation"],
      "tools": ["telemetry-reader", "evidence-reader"],
      "host_mapping": "Morgan"
    },
    {
      "identity": "Vehicle-Localization-RCA",
      "stage": "RCA",
      "responsibility": "test localization covariance, map-match, and tracking degradation hypotheses",
      "inputs": ["vehicle_incident", "localization_covariance", "map_match", "tracking_metrics"],
      "actions": ["read_observed_state", "compare_invariants", "score_hypothesis", "publish_independent_evidence"],
      "outputs": ["localization_hypothesis"],
      "artifacts": ["rca-report.json"],
      "conditions": {"on_map_or_gps_failure": "escalate_high_risk", "on_healthy_localization": "disconfirm_localization_cause"},
      "authority": {"may": ["analyze", "recommend"], "must_not": ["authorize_action", "execute_remediation"]},
      "skills": ["rca-hypothesis-evaluation"],
      "tools": ["telemetry-reader", "invariant-reader"],
      "host_mapping": "Morgan"
    },
    {
      "identity": "Vehicle-Environment-RCA",
      "stage": "RCA",
      "responsibility": "test weather, route, compute, and environmental-interference hypotheses",
      "inputs": ["vehicle_incident", "environment_snapshot", "compute_health", "route_progress"],
      "actions": ["read_environment", "compare_control_signals", "score_hypothesis", "publish_independent_evidence"],
      "outputs": ["environment_hypothesis"],
      "artifacts": ["rca-report.json"],
      "conditions": {"on_missing_environment_data": "pause_for_evidence", "on_healthy_controls": "disconfirm_environment_cause"},
      "authority": {"may": ["analyze", "recommend"], "must_not": ["authorize_action", "execute_remediation"]},
      "skills": ["rca-hypothesis-evaluation"],
      "tools": ["telemetry-reader", "environment-reader"],
      "host_mapping": "Morgan"
    },
    {
      "identity": "Vehicle-Safety-Policy",
      "stage": "POLICY",
      "responsibility": "adjudicate vehicle hypotheses and approve only bounded reversible simulation recovery",
      "inputs": ["vehicle_incident", "perception_hypothesis", "localization_hypothesis", "environment_hypothesis", "safety_flags", "policy_version"],
      "actions": ["rank_evidence", "check_safety_corridor", "check_reversibility", "approve_or_pause_or_reject"],
      "outputs": ["vehicle_policy_decision"],
      "artifacts": ["policy-decision.json"],
      "conditions": {"on_high_risk_or_ambiguous": "pause_and_require_human_approval", "on_unsafe_corridor": "reject_without_action", "on_allowed_simulation_action": "approve_with_expiry_and_rollback"},
      "authority": {"may": ["approve", "reject", "pause", "escalate"], "must_not": ["execute_action", "accept_unsupported_rca"]},
      "skills": ["policy-safety-evaluation"],
      "tools": ["vehicle-policy-registry", "risk-evaluator"],
      "host_mapping": "Danny"
    },
    {
      "identity": "Vehicle-Recovery",
      "stage": "ACTION",
      "responsibility": "execute one allowlisted idempotent reversible digital-twin recovery",
      "inputs": ["vehicle_policy_decision", "before_state", "lease", "idempotency_key"],
      "actions": ["validate_authorization", "resynchronize_sensor_timestamps", "record_after_state", "register_compensation"],
      "outputs": ["vehicle_action_result"],
      "artifacts": ["action-result.json", "intervention-ledger.jsonl"],
      "conditions": {"on_stale_lease": "reject_without_action", "on_duplicate": "return_existing_result", "on_tool_failure": "compensate_or_safe_stop"},
      "authority": {"may": ["execute_approved_simulation_action"], "must_not": ["expand_target", "bypass_policy", "write_production"]},
      "skills": ["bounded-remediation", "compensation-and-rollback"],
      "tools": ["vehicle-digital-twin-adapter", "rollback-registry"],
      "host_mapping": "Rex"
    },
    {
      "identity": "Vehicle-Independent-Verification",
      "stage": "VERIFY",
      "responsibility": "independently read vehicle state and verify recovery invariants",
      "inputs": ["vehicle_action_result", "observed_after_state", "vehicle_invariants", "observation_window"],
      "actions": ["read_observed_state", "check_timestamp_tolerance", "check_fusion_confidence", "check_localization_covariance", "check_tracking", "check_safety_corridor"],
      "outputs": ["vehicle_verifier_report"],
      "artifacts": ["verifier-report.json"],
      "conditions": {"on_all_checks_pass": "pass_to_learning_and_review", "on_any_check_fail": "reject_and_request_compensation", "on_split_brain": "escalate_to_operations_review"},
      "authority": {"may": ["pass", "reject", "request_compensation"], "must_not": ["trust_executor_claim", "execute_remediation", "rewrite_observation"]},
      "skills": ["independent-recovery-verification"],
      "tools": ["vehicle-observed-state-reader", "vehicle-invariant-checker"],
      "host_mapping": "Dr. Sage"
    },
    {
      "identity": "Vehicle-Learning-Review",
      "stage": "POSTMORTEM_REVIEW",
      "responsibility": "convert accepted vehicle evidence into a provenance-linked postmortem and sealed review package",
      "inputs": ["vehicle_verifier_report", "vehicle_action_result", "rejected_hypotheses", "trace", "evidence_manifest"],
      "actions": ["write_postmortem", "derive_runbook_candidate", "seal_evidence", "submit_for_review"],
      "outputs": ["vehicle_postmortem", "vehicle_review_outcome"],
      "artifacts": ["postmortem.md", "evidence-manifest.json", "scorecard.json", "mission-control-snapshot.json"],
      "conditions": {"on_verifier_pass": "seal_and_submit", "on_verifier_reject": "retain_rejected_evidence_and_stop", "on_missing_artifact": "reject_package"},
      "authority": {"may": ["draft_knowledge", "seal_complete_evidence", "reject_incomplete_package"], "must_not": ["promote_rejected_evidence", "rewrite_history", "self_attest_execution"]},
      "skills": ["postmortem-knowledge-consolidation", "operations-review-sealing"],
      "tools": ["evidence-reader", "report-writer", "mission-control-adapter"],
      "host_mapping": "Juno"
    }
  ],
  "stages": ["INCIDENT", "RCA", "POLICY", "ACTION", "VERIFY", "POSTMORTEM_REVIEW"],
  "invariants": ["simulation_only=true", "production_writes=false", "physical_vehicle_connected=false", "policy_precedes_action", "verification_reads_observed_state", "rejected_evidence_is_retained_not_promoted", "run_id_and_correlation_id_are_preserved"]
}
